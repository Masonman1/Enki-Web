# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage
/jest-cache

# Next.js Builds
/.next/
/out/

# Production Builds
/build

# Misc System Files
.DS_Store
*.pem
Thumbs.db
ehthumbs.db

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
supabase.log*  # Supabase CLI/debug logs for Phase 1 DB migrations

# Env Files (Opt-in for commit if needed; protects Supabase/Grok/Claude keys)
.env*
!.env.example  # If you have a sample env for Phase 1 setup

# Vercel Deployment
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
*.tgz  # Packed TS artifacts

# IDE/Editor Configs (e.g., VS Code for Enki dev)
.vscode/*
!.vscode/extensions.json  # If you want to recommend extensions like ESLint/Prettier
.idea/
*.sublime-*
*.swp
*.swo

# Temp/Cache Files (Phase 1-specific: AI stubs, uploads, etc.)
.tmp/
.cache/
dist/
public/build/  # If using custom public assets in Phase 1

# OS-Specific
.Apple*
._*

# Optional: Ignore large uploads or Phase 1 test data (e.g., PDFs for waterproofing specs)
uploads/
test-data/